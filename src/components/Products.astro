---
import { products, formatPrice } from '../data/products';
import ProductVisual from './ui/ProductVisual.astro';
import ClipTitle from './ui/ClipTitle.astro';
import Doodle from './ui/Doodle.astro';

/**
 * Showcase varian — mengikuti FlavorSection SPYLT.
 *
 * Struktur pentingnya: judul raksasa BUKAN elemen yang dipaku diam, melainkan
 * item pertama di dalam rel horizontal. Jadi saat scroll, judul ikut tergeser
 * keluar layar sementara kartu-kartu masuk — dan ketiga lapisan judul bergerak
 * dengan kecepatan berbeda sehingga ada parallax di dalam judulnya sendiri.
 *
 * Latar panggung sengaja dibuat tetap (krem). Warna dibawa oleh panel tiap
 * kartu, seperti SPYLT — bukan dengan mengganti warna seluruh section, yang
 * bikin nav dan judul harus terus menyesuaikan kontras.
 *
 * Dari 1024px : section di-pin, scroll vertikal jadi gerak horizontal.
 * Di bawahnya  : carousel geser native — lihat catatan "MOBILE" di bawah.
 *
 * BATASNYA 1024px, BUKAN 768px seperti sebelumnya. Tablet 768–1023px dulu ikut
 * jalur desktop, dan dua hal jadi salah sekaligus di sana: kartunya 40vw × 70vh
 * — di 834px itu 334×778, proporsi yang terlalu jangkung dan sempit — dan
 * scroll-nya dibajak di perangkat yang justru paling tidak menyukainya, karena
 * jari tidak punya cara membatalkan pin seperti roda mouse. Ukuran vw di
 * seluruh section ini memang ditala untuk 1440px.
 *
 * MOBILE — tetap horizontal, TIDAK ditumpuk vertikal seperti Minuman.
 * Enam kartu setinggi ~70svh yang ditumpuk berarti empat-lima layar berisi
 * bentuk yang sama persis, tepat sebelum section Minuman yang memang vertikal.
 * Rel ke samping membuat "pilih rasa" terasa seperti memilih, bukan membaca
 * katalog. Yang dibenahi justru hal-hal yang dulu membuatnya terasa seperti
 * foto diam:
 *
 *  - Judul keluar dari rel dan jadi kepala statis. Dulu slide pertama adalah
 *    judul selebar 86vw, jadi saat section masuk tidak ada satu kartu pun
 *    yang terlihat dan tidak ada tanda bahwa ini bisa digeser.
 *  - Kartu 78vw dengan padding rel 11vw: ujung kartu berikutnya selalu
 *    mengintip ~7vw. Itu isyarat "geser" yang paling kuat, lebih kuat dari
 *    teks petunjuk apa pun.
 *  - Kartu aktif "diangkat": tegak dan penuh, tetangganya mengecil dan miring
 *    ke kemiringan stikernya. Ditulis ulang tiap frame scroll di products.js.
 *  - Titik berwarna varian + tombol panah di bawah rel, dalam jangkauan jempol.
 */

// Kemiringan tiap kartu dibuat tetap dan berbeda-beda, seperti kelas rotation
// di flavorlists SPYLT — deretan kartu jadi tidak terasa seperti tabel.
const rotations = [-5, 4, -3, 6, -4, 3];
const total = String(products.length).padStart(2, '0');
---

<section id="varian" data-products data-nav-theme="light" class="relative overflow-hidden bg-cream">
  <!--
    Penghitung desktop. Di luar panggung supaya tidak ikut tergeser; pin
    membungkus section, jadi anak absolut ini ikut terpaku bersamanya.
  -->
  <div class="pointer-events-none absolute inset-x-0 top-0 z-20 hidden justify-end px-12 pt-28 lg:flex">
    <div class="text-ink flex items-baseline gap-2">
      <span class="font-display text-[clamp(1.6rem,3vw,2.6rem)] leading-none" data-products-index>01</span>
      <span class="font-body text-sm opacity-50">/ {total}</span>
    </div>
  </div>

  <!--
    Kepala section mobile. Isinya kalimat yang sama dengan judul raksasa di rel
    desktop, tapi disusun rata kiri dan dipadatkan: ini yang pertama dibaca,
    lalu matanya turun ke kartu — bukan harus menggeser melewati satu slide
    penuh teks dulu.

    Ukuran "Kami punya 6" (9.6vw, maks 3.6rem) sengaja disamakan dengan skala
    xl ClipTitle di lebar mobile dan tablet, supaya kotak RASA tidak terlihat
    lebih kecil dari baris di atasnya.
  -->
  <header class="relative z-10 px-5 pt-24 sm:px-10 sm:pt-28 lg:hidden" data-products-head>
    <div class="flex items-baseline justify-between" data-head-el>
      <span class="font-hand text-pink text-xl sm:text-2xl">pilih rasamu</span>
      <div class="text-ink flex items-baseline gap-1.5" aria-hidden="true">
        <span class="font-display text-[1.9rem] leading-none" data-products-index>01</span>
        <span class="font-body text-sm opacity-50">/ {total}</span>
      </div>
    </div>

    <h2 class="mt-3 flex flex-col items-start gap-2 uppercase">
      <span class="text-indigo text-[clamp(2.4rem,9.6vw,3.6rem)] leading-[0.88]" data-head-el>
        Kami punya {products.length}
      </span>
      <span class="mt-1" data-head-clip>
        <ClipTitle text="RASA" bg="#e52c74" color="#faf5e9" border="#faf5e9" rotate={-3} from="left" size="xl" />
      </span>
      <span class="text-pink pb-[0.2em] text-[clamp(2.4rem,9.6vw,3.6rem)] leading-[0.88]" data-head-el>
        yang bikin nagih
      </span>
    </h2>
  </header>

  <div class="relative" data-products-rail>
    {/*
      Pendar warna varian aktif di belakang rel, hanya mobile. Di desktop
      panggungnya selebar layar dan kartunya sendiri sudah mengisi warna; di
      layar sempit krem polos di sekitar kartu terasa kosong, dan pendar ini
      yang membuat pergantian varian terasa sebagai perubahan suasana, bukan
      cuma ganti gambar.

      mask radial + background-color, BUKAN radial-gradient: gradien tidak bisa
      ditransisikan, warna latar bisa.
    */}
    <div
      aria-hidden="true"
      class="pointer-events-none absolute left-1/2 top-1/2 aspect-square w-[140vw] -translate-x-1/2 -translate-y-1/2 opacity-[0.22] transition-[background-color] duration-700 [mask-image:radial-gradient(closest-side,#000,transparent)] lg:hidden"
      style={`background-color:${products[0].stage}`}
      data-products-glow
    >
    </div>

    {/*
      Scroll-snap-nya ditulis di CSS (max-lg:), bukan dipasang dari JS seperti
      dulu. Saat reduced-motion main.js tidak menjalankan animasi section, dan
      rel yang overflow-nya menunggu JS jadi mati total: enam kartu, hanya satu
      yang bisa dilihat.
    */}
    <div
      data-products-stage
      class="relative flex flex-col justify-center py-10 [scrollbar-width:none] max-lg:snap-x max-lg:snap-mandatory max-lg:overflow-x-auto max-lg:overscroll-x-contain lg:h-[100svh] lg:py-0 [&::-webkit-scrollbar]:hidden"
      aria-label="Varian Thago"
      tabindex="-1"
    >
      <div
        class="flex w-max items-center gap-[4vw] px-[11vw] will-change-transform sm:gap-[5vw] sm:px-[22vw] lg:gap-[14vw] lg:px-[6vw]"
        data-products-track
      >
        <!--
          Judul desktop: item pertama di rel, ikut tergeser keluar saat scroll.
          Lebarnya sengaja besar — rel bergerak dengan kecepatan tetap, jadi lebar
          blok inilah yang menentukan berapa lama judul bertahan di layar sebelum
          tersapu keluar. Kalau terlalu sempit, judulnya cuma berkelebat.
        -->
        <div
          class="hidden w-[70vw] flex-none flex-col items-center justify-center gap-2 text-center lg:flex"
          data-products-intro
        >
          <div class="overflow-hidden" data-intro-line>
            <h2
              class="text-indigo text-[clamp(2.4rem,7.2vw,6.4rem)] tracking-[-0.01em] uppercase"
              data-intro-text
            >
              Kami punya {products.length}
            </h2>
          </div>

          <div class="w-max" data-intro-line>
            <ClipTitle text="RASA" bg="#e52c74" color="#faf5e9" border="#faf5e9" rotate={-3} size="xl" />
          </div>

          <div class="overflow-hidden" data-intro-line>
            <h2
              class="text-pink text-[clamp(2.4rem,7.2vw,6.4rem)] tracking-[-0.01em] uppercase"
              data-intro-text
            >
              yang bikin nagih
            </h2>
          </div>
        </div>

        <!-- Kartu varian -->
        {
          products.map((p, i) => (
            <article
              class="relative flex h-[clamp(480px,70svh,620px)] w-[78vw] max-w-[620px] flex-none snap-center snap-always flex-col overflow-hidden rounded-[2rem] shadow-[0_18px_0_rgba(36,20,99,0.15)] sm:w-[56vw] lg:h-[70vh] lg:w-[40vw] lg:rounded-[2.75rem]"
              style={`background-color:${p.stage}; rotate:${rotations[i % rotations.length]}deg`}
              aria-label={`${i + 1} dari ${products.length}: ${p.name}`}
              data-product-card
              data-index={i}
              data-rotate={rotations[i % rotations.length]}
              data-stage={p.stage}
            >
              {p.isNew && (
                <span class="sticker bg-yellow text-ink absolute left-5 top-5 z-20 -rotate-6 text-xs md:text-sm">
                  baru!
                </span>
              )}

              {/*
                Foto MENGAMBIL SISA RUANG, bukan 58% tinggi kartu yang dipatok.

                Dengan angka tetap, tinggi blok teks di bawahnya tidak pernah ikut
                diperhitungkan — padahal teks itu memanjang sendiri di layar
                sempit: di 360px chip-nya jadi tiga baris dan catatan steviamnya
                tiga baris juga. Blok teks tumbuh ke atas menembus kotak foto, dan
                nama varian berakhir di atas foto cup yang ramai. Tidak terbaca.

                flex-1 + min-h-0 membuat foto menyusut persis sebanyak teks
                tumbuh, jadi keduanya tidak pernah berebut piksel yang sama di
                lebar layar mana pun.
              */}
              <div class="flex min-h-0 flex-1 justify-center pt-4 lg:pt-6" data-product-visual>
                <ProductVisual
                  product={p}
                  loading={i < 2 ? 'eager' : 'lazy'}
                  class="drop-shadow-[0_18px_28px_rgba(36,20,99,0.28)]"
                />
              </div>

              {/* nama varian di kiri bawah, seperti kartu flavor SPYLT */}
              <div class="relative z-10 shrink-0 p-5 sm:p-6 md:p-8" style={`color:${p.onStage}`}>
                <h3
                  class="font-display text-[clamp(1.7rem,3.4vw,3rem)] leading-[0.95] uppercase"
                  data-product-el
                >
                  {p.name}
                </h3>
                <p class="font-hand mt-1 text-lg opacity-85 md:text-xl" data-product-el>{p.tagline}</p>

                {/*
                  Empat chip mengikuti urutan di stiker tutup asli. Gula TIDAK
                  ikut: labelnya memang tidak memecah gula, yang tertulis di sana
                  "(use stevia)". Klaimnya pindah ke baris tulisan tangan di bawah
                  sebagai "tanpa gula tambahan" — yang didukung label, sementara
                  "0 g gula" tidak.
                */}
                <ul class="mt-3 flex flex-wrap gap-1.5 sm:mt-4 sm:gap-2" data-product-el>
                  {[
                    `${p.nutrition.kcal} kkal`,
                    `${p.nutrition.protein}g protein`,
                    `${p.nutrition.fiber}g serat`,
                    `${p.nutrition.carbs}g karbo`,
                  ].map((chip) => (
                    <li
                      class="rounded-full border px-2.5 py-1 text-xs font-medium sm:px-3"
                      style={`border-color:${p.onStage}55`}
                    >
                      {chip}
                    </li>
                  ))}
                </ul>

                {/*
                  Di mobile klaimnya dipendekkan jadi satu baris. Versi panjangnya
                  memakan tiga baris di 360px, dan setiap baris teks di sini
                  langsung memotong tinggi foto cup di atasnya (lihat flex-1).
                */}
                <p class="font-hand mt-2.5 text-base opacity-80 sm:mt-3 sm:text-lg" data-product-el>
                  <span class="lg:hidden">✦ tanpa gula tambahan</span>
                  <span class="hidden lg:inline">✦ tanpa gula tambahan, manisnya dari stevia</span>
                </p>

                {/*
                  Label tombol dibuat tetap, bukan "Pesan {nama}": nama varian di
                  lini ini sampai 25 karakter ("Green Tea with Strawberry") dan
                  tombolnya melar melewati lebar kartu. Nama lengkapnya tetap
                  sampai ke pembaca layar lewat aria-label.

                  Di mobile harga dan tombol diapit ke dua ujung: tombolnya jatuh
                  di kanan bawah, tepat di bawah jempol kanan.
                */}
                <div
                  class="mt-4 flex flex-wrap items-center justify-between gap-x-5 gap-y-3 sm:mt-5 lg:justify-start"
                  data-product-el
                >
                  <span class="font-display text-[clamp(1.3rem,2.4vw,1.8rem)] leading-none">
                    {formatPrice(p.price)}
                  </span>
                  <a
                    href="#pesan"
                    aria-label={`Pesan ${p.name}`}
                    class="btn-bubble px-6 py-3 text-sm"
                    style={`background-color:${p.onStage};color:${p.stage}`}
                  >
                    Pesan yang ini
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>

  <!--
    Kendali mobile, tepat di bawah rel dan dalam jangkauan jempol.

    Titiknya diwarnai panel varian masing-masing, jadi sekaligus berfungsi
    sebagai legenda: kamu tahu ada cokelat dan hijau di depan sebelum sampai ke
    sana. Tiap tombol minimal 24×44px — titik 10px yang bisa diketuk tepat
    hanya ada di Figma.
  -->
  <div class="relative z-10 flex items-center justify-between gap-4 px-5 pb-20 sm:px-10 lg:hidden" data-products-controls>
    <div class="-ml-[7px] flex items-center" role="group" aria-label="Pilih varian">
      {
        products.map((p, i) => (
          <button
            type="button"
            class="group grid h-11 place-items-center px-[7px]"
            aria-label={`Lihat ${p.name}`}
            aria-current={i === 0 ? 'true' : 'false'}
            data-products-dot
          >
            <span
              class="ring-ink/25 block h-2.5 w-2.5 rounded-full ring-1 transition-[width] duration-500 ease-out group-aria-[current=true]:w-7"
              style={`background-color:${p.stage}`}
            />
          </button>
        ))
      }
    </div>

    <div class="flex gap-2">
      <button
        type="button"
        class="border-ink text-ink grid size-11 place-items-center rounded-full border-2 transition-opacity disabled:opacity-25"
        aria-label="Varian sebelumnya"
        disabled
        data-products-prev
      >
        <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
      </button>
      <button
        type="button"
        class="bg-ink text-cream border-ink grid size-11 place-items-center rounded-full border-2 transition-opacity disabled:opacity-25"
        aria-label="Varian berikutnya"
        data-products-next
      >
        <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
      </button>
    </div>
  </div>

  <!-- Petunjuk arah desktop. Di mobile tugasnya diambil kartu yang mengintip. -->
  <div
    class="text-ink/55 pointer-events-none absolute bottom-8 left-1/2 z-20 hidden -translate-x-1/2 items-center gap-3 lg:flex"
    data-products-hint
  >
    <span class="font-hand text-lg">terus scroll</span>
    <Doodle name="arrow" class="w-14" stroke={7} />
  </div>
</section>
